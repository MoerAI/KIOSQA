{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "target/**/*.ts", "runner/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "playwright.*.ts"],
  "exclude": ["node_modules", ".kioskproof", ".venv"]
}
